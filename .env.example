# Runtime (Cloudflare Worker) — usado por lib/supabase.ts vía fetch/PostgREST.
# En producción se configuran como `wrangler secret put`, no como .env.
SUPABASE_URL="https://xxxxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# Solo para tooling local de Prisma (migrate / studio / seed) — Prisma NO corre
# en runtime, únicamente se usa para administrar el schema de la base.
DATABASE_URL="postgresql://postgres:password@db.xxxxxxxx.supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:password@db.xxxxxxxx.supabase.co:5432/postgres"

# Site
NEXT_PUBLIC_SITE_URL="https://busago.ai"
NEXT_PUBLIC_WHATSAPP_NUMBER="5491100000000"

# Plan Personalizado - lead form destination (opcional, ej. Resend/Airtable webhook)
LEADS_WEBHOOK_URL=""

# Notificación por email de nuevos leads (Resend - resend.com)
RESEND_API_KEY=""
LEADS_NOTIFICATION_EMAIL=""

# Agente de voz (LiveKit Agent Builder)
# NEXT_PUBLIC_LIVEKIT_AGENT_ID: id del agente (CA_xxx) para el widget embebido
#   (LiveKit Cloud → Agents → Busaia → "Embed drawer"). No es secreto.
# LIVEKIT_WEBHOOK_SECRET: valor arbitrario que también se configura como header
#   custom en el builder (sección "Call ending"), para validar que el POST a
#   /api/leads/voice viene realmente de LiveKit.
NEXT_PUBLIC_LIVEKIT_AGENT_ID=""
LIVEKIT_WEBHOOK_SECRET=""

# Demo en vivo del agente (botón Play en el bento "Agentes de Voz") — usa
# livekit-client contra un token propio, no el widget embebido. Se consiguen
# en LiveKit Cloud → Settings → Keys (API Key/Secret) y la URL del proyecto
# (wss://xxxxx.livekit.cloud).
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
LIVEKIT_URL=""

# Bot de mensajes (bento "Asistentes IA para WhatsApp y Web") — /api/chat usa
# Groq (Llama 3.1) para el texto y Whisper (también en Groq) para transcribir
# audios, con los servicios de la tabla `services` como contexto (RAG simple,
# sin vector DB). Conseguís la key en console.groq.com/keys.
GROQ_API_KEY=""
